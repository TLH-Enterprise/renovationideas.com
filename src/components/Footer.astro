---
const whatsappNumber = "14693065031";
const whatsappMessageEn =
  "Hello, I'm interested in learning more about your renovation services.";
const whatsappMessageEs =
  "Hola, me interesa conocer más sobre sus servicios de renovación.";
const whatsappUrlEn = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessageEn)}`;
const whatsappUrlEs = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessageEs)}`;

// Contact information
const contactAddress = "301 S Jupiter rd, Allen, TX";
const contactPhone = "+14693065031";
const contactPhoneDisplay = "(+1) 469-306-5031";
const contactEmail = "renovationsideas23@gmail.com";
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contactAddress)}`;
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <!-- Left Column: Logo + Button -->
      <div class="footer-section footer-brand">
        <div class="footer-logo">
          <img
            src="/logo-renovation-ideas-normal.png"
            alt="Renovation Ideas Logo"
            class="footer-logo-image"
          />
          <div class="footer-logo-text">
            <span class="footer-logo-line1">Renovation</span>
            <span class="footer-logo-line2">Ideas</span>
          </div>
        </div>
        <a
          href={whatsappUrlEn}
          target="_blank"
          class="footer-cta-button"
          data-i18n="contact.button"
          data-whatsapp-en={whatsappUrlEn}
          data-whatsapp-es={whatsappUrlEs}
        >
          Get started now
        </a>
      </div>

      <!-- Middle Column: Quick Links -->
      <div class="footer-section">
        <h4 data-i18n="footer.quickLinks">Quick links</h4>
        <ul class="footer-links">
          <li><a href="#about" data-i18n="footer.about">About us</a></li>
          <li><a href="#work" data-i18n="footer.work">Our work</a></li>
          <li><a href="#services" data-i18n="footer.services">Services</a></li>
          <li><a href="#contact" data-i18n="footer.contact">Contact</a></li>
        </ul>
      </div>

      <!-- Third Column: Social Media -->
      <div class="footer-section">
        <h4 data-i18n="footer.socialmedia">Social Media</h4>
        <ul class="footer-social">
          <li>
            <a
              href="https://www.instagram.com/renovationsideas/"
              target="_blank"
              class="social-link"
            >
              <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                ></path>
              </svg>
              <span data-i18n="footer.instagram">Instagram</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Fourth Column: Contact Info -->
      <div class="footer-section">
        <h4 data-i18n="footer.contactInfo">Contact Info</h4>
        <ul class="footer-contact">
          <li>
            <span class="footer-contact-label" data-i18n="footer.address">Address:</span>
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="footer-contact-link">
              {contactAddress}
            </a>
          </li>
          <li>
            <span class="footer-contact-label" data-i18n="footer.email">Email:</span>
            <a href={`mailto:${contactEmail}`} class="footer-contact-link">{contactEmail}</a>
          </li>
          <li>
            <span class="footer-contact-label" data-i18n="footer.phone">Phone:</span>
            <a href={`tel:${contactPhone}`} class="footer-contact-link">{contactPhoneDisplay}</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="footer-copyright">
      <p>
        <span data-i18n="footer.copyright">
          © 2025 Renovation Ideas. All rights reserved.
        </span>
        <span class="footer-separator"> • </span>
        <span class="footer-powered">
          Powered by{" "}
          <a
            href="https://www.thelasthope.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="tlh-link"
          >
            T L H
            <svg
              class="heart-icon"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
              ></path>
            </svg>
          </a>
        </span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #f8f9fa;
    color: #1a1a1a;
    padding: 2.5rem 0 1.5rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 1.5rem;
  }

  .footer-section {
    display: flex;
    flex-direction: column;
  }

  .footer-brand {
    gap: 1.25rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-logo-image {
    height: 35px;
    width: auto;
    object-fit: contain;
  }

  .footer-logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .footer-logo-line1,
  .footer-logo-line2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1a1a1a;
  }

  .footer-cta-button {
    display: inline-block;
    background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 50%, #3b82f6 100%);
    color: white;
    padding: 0.7rem 1.5rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.3s ease;
    width: fit-content;
  }

  .footer-cta-button:hover {
    background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 50%, #2563eb 100%);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(30, 58, 138, 0.4);
  }

  .footer-section h4 {
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 1rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    color: #6c757d;
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.3s ease;
  }

  .footer-links a:hover {
    color: #1a1a1a;
  }

  .footer-social {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: #6c757d;
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.3s ease;
  }

  .social-link:hover {
    color: #1a1a1a;
  }

  .social-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .footer-contact {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-contact li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-contact-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #6c757d;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .footer-contact-value,
  .footer-contact-link {
    font-size: 0.875rem;
    color: #6c757d;
    line-height: 1.5;
  }

  .footer-contact-link {
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-contact-link:hover {
    color: #1a1a1a;
  }

  .footer-copyright {
    text-align: center;
    padding-top: 1.5rem;
    border-top: 1px solid #dee2e6;
  }

  .footer-copyright p {
    margin: 0;
    color: #6c757d;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .footer-separator {
    color: #6c757d;
  }

  .footer-powered {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .tlh-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: #5d2e8c;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .tlh-link:hover {
    color: #7c3aed;
  }

  .heart-icon {
    width: 16px;
    height: 16px;
    fill: #5d2e8c;
    transition: transform 0.3s ease;
  }

  .tlh-link:hover .heart-icon {
    transform: scale(1.2);
    fill: #7c3aed;
  }

  @media (max-width: 1024px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-brand {
      align-items: center;
      text-align: center;
    }

    .footer-logo {
      justify-content: center;
    }

    .footer-section {
      align-items: center;
      text-align: center;
    }

    .footer-links,
    .footer-social {
      align-items: center;
    }
  }

  @media (max-width: 768px) {
    .footer {
      padding: 2rem 0 1.25rem;
    }

    .footer-content {
      gap: 1.5rem;
      margin-bottom: 1.25rem;
    }

    .footer-copyright {
      padding-top: 1.25rem;
    }
  }
</style>

<script>
  // The WhatsApp URL switching is handled automatically by i18n.ts
  // which listens for elements with data-whatsapp-en and data-whatsapp-es attributes
</script>
