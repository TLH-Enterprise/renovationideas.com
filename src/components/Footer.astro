---
// Footer Component
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-section">
        <h4 data-i18n="footer.quickLinks">Quick links</h4>
        <ul>
          <li><a href="#about" data-i18n="footer.about">About us</a></li>
          <li><a href="#work" data-i18n="footer.work">Our work</a></li>
          <li><a href="#services" data-i18n="footer.services">Services</a></li>
          <li><a href="#contact" data-i18n="footer.contact">Contact</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <p data-i18n="footer.copyright">
          &copy; 2025 Renovation Ideas. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #1a1a2e;
    color: white;
    padding: 3rem 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .footer-section ul {
    list-style: none;
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .footer-section a {
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.3s;
  }

  .footer-section a:hover {
    color: white;
  }

  .footer-section h4 {
    margin-bottom: 1rem;
    color: white;
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
