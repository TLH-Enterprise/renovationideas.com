---
// Language Toggle Component
---

<div class="language-toggle-container">
  <button class="language-option" data-lang="en" aria-label="Switch to English">
    EN
  </button>
  <button class="language-option" data-lang="es" aria-label="Switch to Spanish">
    ES
  </button>
</div>

<style>
  .language-toggle-container {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 25px;
    padding: 0.25rem;
    gap: 0.25rem;
    transition: all 0.3s ease;
  }

  .navbar.scrolled .language-toggle-container {
    background: rgba(255, 255, 255, 0.95);
    border: 2px solid rgba(0, 0, 0, 0.5);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .language-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: none;
    border-radius: 20px;
    padding: 0.5rem 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
    min-width: 45px;
    justify-content: center;
  }

  .navbar.scrolled .language-option {
    color: rgba(26, 26, 46, 0.8);
    text-shadow: none;
  }

  .language-option.active {
    background: rgba(255, 255, 255, 0.95);
    color: #1a1a2e;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    text-shadow: none;
  }

  .navbar.scrolled .language-option.active {
    background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 50%, #3b82f6 100%);
    color: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .navbar.scrolled .language-option:not(.active) {
    color: #1e3a8a;
    background: transparent;
    border: 1px solid #1e3a8a;
    font-weight: 400;
  }

  .language-option:hover:not(.active) {
    background: rgba(255, 255, 255, 0.3);
    color: rgba(255, 255, 255, 1);
    transform: scale(1.05);
  }

  .navbar.scrolled .language-option:hover:not(.active) {
    background: rgba(0, 0, 0, 0.05);
    color: #1e3a8a;
    border-color: #000000;
    transform: scale(1.05);
  }

  .language-flag {
    font-size: 1.1rem;
    line-height: 1;
  }

  .language-text {
    font-size: 0.85rem;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .language-toggle-container {
      padding: 0.2rem;
      gap: 0.2rem;
    }

    .language-option {
      padding: 0.4rem 0.8rem;
      gap: 0.4rem;
    }

    .language-flag {
      font-size: 1rem;
    }

    .language-text {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  // Language toggle functionality
  const defaultLanguage: "en" | "es" = "en";

  // Get language from localStorage or use default
  const getCurrentLanguage = (): "en" | "es" => {
    const saved = localStorage.getItem("language") as "en" | "es" | null;
    return saved || defaultLanguage;
  };

  // Set language in localStorage and update UI
  const setLanguage = (lang: "en" | "es") => {
    localStorage.setItem("language", lang);
    updateToggleUI(lang);
    updatePageContent(lang);
  };

  // Update toggle buttons UI
  const updateToggleUI = (lang: "en" | "es") => {
    const enButton = document.querySelector(
      '.language-option[data-lang="en"]'
    ) as HTMLElement;
    const esButton = document.querySelector(
      '.language-option[data-lang="es"]'
    ) as HTMLElement;

    if (enButton && esButton) {
      // Remove active class from both
      enButton.classList.remove("active");
      esButton.classList.remove("active");

      // Add active class to selected language
      if (lang === "en") {
        enButton.classList.add("active");
      } else {
        esButton.classList.add("active");
      }
    }
  };

  // Update page content based on language
  const updatePageContent = (lang: "en" | "es") => {
    // Dispatch custom event for components to listen
    const event = new CustomEvent("languageChange", {
      detail: { language: lang },
    });
    document.dispatchEvent(event);
  };

  // Initialize language on page load
  const currentLang = getCurrentLanguage();
  updateToggleUI(currentLang);
  updatePageContent(currentLang);

  // Handle language option clicks
  document.querySelectorAll(".language-option").forEach((button) => {
    button.addEventListener("click", () => {
      const lang = (button as HTMLElement).getAttribute("data-lang") as
        | "en"
        | "es";
      if (lang) {
        setLanguage(lang);
      }
    });
  });
</script>
