---
// Work Section Component
---

<section id="work" class="work">
  <div class="container">
    <h2 class="section-title" data-scroll-fade data-i18n="work.title">
      Our Work
    </h2>
    <h3 class="section-subtitle" data-scroll-fade data-i18n="work.subtitle">
      Get inspired by our work
    </h3>
    <p class="work-intro" data-scroll-fade data-i18n="work.intro">
      See how we've transformed homes with our expert craftsmanship and
      attention to detail.
    </p>
    <div class="work-grid">
      <div class="work-item" data-scroll-fade>
        <div class="work-image-wrapper">
          <img
            src="/kitchen-remodelation.jpg"
            alt="Modern kitchen refit"
            class="work-image"
          />
        </div>
        <h4 data-i18n="work.projects.kitchen.title">Modern kitchen refit</h4>
        <p data-i18n="work.projects.kitchen.description">
          This kitchen transformation brought modern and elegant design and
          improved functionality to our client's home. We installed custom
          cabinets, high-quality countertops and state-of-the-art appliances,
          creating an elegant yet practical space perfect for cooking and
          entertaining.
        </p>
        <div class="work-meta">
          <span class="work-tag" data-i18n="work.projects.kitchen.tag"
            >Kitchen</span
          >
          <span class="work-duration" data-i18n="work.projects.kitchen.duration"
            >4 weeks</span
          >
        </div>
      </div>
      <div class="work-item" data-scroll-fade>
        <div class="work-image-wrapper">
          <img
            src="/bathroom-remodelation.jpg"
            alt="Master bathroom renovation"
            class="work-image"
          />
        </div>
        <h4 data-i18n="work.projects.bathroom.title">
          Master bathroom renovation
        </h4>
        <p data-i18n="work.projects.bathroom.description">
          We transformed an outdated bathroom into a modern relaxation oasis.
          Includes luxury tiles, rain shower, freestanding bathtub and
          first-class finishes that combine elegance with functionality.
        </p>
        <div class="work-meta">
          <span class="work-tag" data-i18n="work.projects.bathroom.tag"
            >Bathroom</span
          >
          <span
            class="work-duration"
            data-i18n="work.projects.bathroom.duration">3 weeks</span
          >
        </div>
      </div>
      <div class="work-item" data-scroll-fade>
        <div class="work-image-wrapper">
          <img
            src="/interior-remodelation.jpg"
            alt="Kitchen and dining room extension"
            class="work-image"
          />
        </div>
        <h4 data-i18n="work.projects.extension.title">
          Kitchen and dining room extension
        </h4>
        <p data-i18n="work.projects.extension.description">
          We expanded the living space with a bright extension that connects the
          kitchen to the garden. Open design with large windows, natural
          lighting and modern finishes that create a cozy and functional
          environment.
        </p>
        <div class="work-meta">
          <span class="work-tag" data-i18n="work.projects.extension.tag"
            >Extension</span
          >
          <span
            class="work-duration"
            data-i18n="work.projects.extension.duration">8 weeks</span
          >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .work {
    background: #f8fafc;
    padding: 6rem 0;
    position: relative;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #5d2e8c 0%, #e0408f 50%, #ff8c42 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-subtitle {
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    text-align: center;
    margin-bottom: 3rem;
    color: #64748b;
    font-weight: 400;
  }

  [data-scroll-fade] {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  [data-scroll-fade].visible {
    opacity: 1;
    transform: translateY(0);
  }

  .work-intro {
    text-align: center;
    margin-bottom: 4rem;
    color: #64748b;
    font-size: 1.15rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
    margin-top: 4rem;
  }

  .work-item {
    background: white;
    padding: 0;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    transition:
      transform 0.3s,
      box-shadow 0.3s;
  }

  .work-item:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 50px rgba(93, 46, 140, 0.2);
  }

  .work-image-wrapper {
    width: 100%;
    height: 250px;
    position: relative;
    overflow: hidden;
  }

  .work-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .work-item:hover .work-image {
    transform: scale(1.1);
  }

  .work-item h4 {
    font-size: 1.5rem;
    margin: 1.5rem 1.5rem 1rem;
    color: #1e293b;
  }

  .work-item p {
    color: #64748b;
    line-height: 1.7;
    margin: 0 1.5rem 1.5rem;
  }

  .work-meta {
    display: flex;
    gap: 1rem;
    margin: 0 1.5rem 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid #e2e8f0;
  }

  .work-tag {
    background: linear-gradient(135deg, #5d2e8c 0%, #e0408f 50%, #ff8c42 100%);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .work-duration {
    color: #64748b;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
  }

  @media (max-width: 768px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: "0px 0px -100px 0px",
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
      }
    });
  }, observerOptions);

  document.querySelectorAll("[data-scroll-fade]").forEach((el) => {
    observer.observe(el);
  });
</script>
