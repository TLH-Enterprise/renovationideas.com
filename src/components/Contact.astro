---
const contactBgImage = "/contact-bg.jpg";

// Contact information
const contactAddress = "301 S Jupiter rd, Allen, TX";
const contactPhone = "+14693065031";
const contactPhoneDisplay = "469-306-5031";
const contactEmail = "renovationsideas23@gmail.com";

// URLs for actions
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contactAddress)}`;
const smsUrl = `sms:${contactPhone}`;
---

<section id="contact" class="contact">
  <div
    class="contact-background-image"
    style={`background-image: url(${contactBgImage});`}
  >
  </div>
  <div class="contact-overlay"></div>
  <div class="container">
    <div class="contact-content" data-scroll-fade>
      <h2 class="contact-title" data-i18n="contact.title">
        Make your House a Home you love.
      </h2>
      
      <div class="contact-info">
        <!-- Address Row -->
        <div class="contact-item">
          <h3 class="contact-column-title" data-i18n="contact.addressLabel">Address</h3>
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="contact-info-link">
            {contactAddress}
          </a>
        </div>
        
        <!-- Email Row -->
        <div class="contact-item">
          <h3 class="contact-column-title" data-i18n="contact.emailLabel">Email</h3>
          <a href={`mailto:${contactEmail}`} class="contact-info-link">
            {contactEmail}
          </a>
        </div>
        
        <!-- Phone Row -->
        <div class="contact-item">
          <h3 class="contact-column-title" data-i18n="contact.phoneLabel">Phone</h3>
          <a href={smsUrl} class="contact-info-link">
            {contactPhoneDisplay}
          </a>
        </div>

        <!-- Divider -->
        <div class="contact-divider"></div>

        <!-- Social Media -->
        <div class="contact-social">
          <h3 class="contact-column-title" data-i18n="contact.socialLabel">Social</h3>
          <div class="social-icons">
            <a
              href="https://www.instagram.com/renovationsideas/"
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-link"
              aria-label="Instagram"
            >
              <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    color: white;
    padding: 8rem 0;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .contact-background-image {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 0;
  }

  .contact-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px);
    z-index: 1;
    pointer-events: none;
  }

  .container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    width: 100%;
  }

  .contact-content {
    width: 100%;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 3rem;
  }

  .contact-heading {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    color: white;
    margin: 0 0 2.5rem 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .contact-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: white;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    text-align: center;
    max-width: 100%;
    box-sizing: border-box;
  }

  [data-scroll-fade] {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  [data-scroll-fade].visible {
    opacity: 1;
    transform: translateY(0);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    max-width: 600px;
    text-align: center;
    margin: 0 auto;
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
  }

  .contact-divider {
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
    margin: 1rem 0;
  }

  .contact-social {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  .social-icons {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .social-icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .social-icon-link:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .social-icon {
    width: 20px;
    height: 20px;
  }

  .contact-column-title {
    font-size: 0.875rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    text-transform: none;
    letter-spacing: 0;
  }

  .contact-info-link {
    display: block;
    font-size: 1.25rem;
    font-weight: 600;
    color: white;
    text-decoration: none;
    margin: 0.5rem 0;
    line-height: 1.8;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    transition: all 0.3s ease;
    position: relative;
    padding-bottom: 0.25rem;
  }

  .contact-info-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #1e3a8a, #2563eb, #3b82f6);
    transition: width 0.3s ease;
  }

  .contact-info-link:hover {
    color: rgba(255, 255, 255, 0.95);
    transform: translateX(5px);
  }

  .contact-info-link:hover::after {
    width: 100%;
  }

  .whatsapp-button {
    display: inline-block;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    color: white;
    padding: 1.2rem 3.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1.1rem;
    text-decoration: none;
    transition:
      transform 0.3s,
      background 0.3s,
      box-shadow 0.3s;
    border: 1px solid rgba(255, 255, 255, 0.3);
    cursor: pointer;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
  }

  .whatsapp-button:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.25);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 968px) {
    .container {
      grid-template-columns: 1fr;
    }

    .contact-left {
      margin-left: 0;
      padding: 3rem 2rem;
      justify-content: center;
    }

    .contact-info {
      max-width: 100%;
    }

    .contact-right {
      padding: 3rem 2rem;
      min-height: 50vh;
    }
  }

  @media (max-width: 768px) {
    .contact {
      padding: 4rem 0;
    }

    .contact-left {
      padding: 2.5rem 1.5rem;
    }

    .contact-right {
      padding: 2.5rem 1.5rem;
    }

    .contact-title {
      font-size: clamp(2rem, 8vw, 3rem);
    }

    .contact-info {
      gap: 2rem;
    }
  }
</style>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: "0px 0px -100px 0px",
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
      }
    });
  }, observerOptions);

  document.querySelectorAll("[data-scroll-fade]").forEach((el) => {
    observer.observe(el);
  });
</script>
