---
const whatsappNumber = "1234567890";
const whatsappMessageEn =
  "Hello, I'm interested in learning more about your renovation services.";
const whatsappMessageEs =
  "Hola, me interesa conocer más sobre sus servicios de renovación.";
const whatsappUrlEn = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessageEn)}`;
const whatsappUrlEs = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessageEs)}`;
const contactBgImage = "/contact-bg.jpg";
---

<section id="contact" class="contact">
  <div
    class="contact-background-image"
    style={`background-image: url(${contactBgImage});`}
  >
  </div>
  <div class="contact-overlay"></div>
  <div class="container">
    <h2 class="contact-title" data-scroll-fade data-i18n="contact.title">
      Make your House a Home you love.
    </h2>
    <a
      href={whatsappUrlEn}
      target="_blank"
      class="whatsapp-button"
      data-scroll-fade
      data-i18n="contact.button"
      data-whatsapp-en={whatsappUrlEn}
      data-whatsapp-es={whatsappUrlEs}>Get started now</a
    >
  </div>
</section>

<style>
  .contact {
    position: relative;
    color: white;
    padding: 8rem 0;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .contact-background-image {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 0;
  }

  .contact-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 1;
  }

  .container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 3rem;
  }

  .contact-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: white;
    margin: 0;
    max-width: 900px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  [data-scroll-fade] {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  [data-scroll-fade].visible {
    opacity: 1;
    transform: translateY(0);
  }

  .whatsapp-button {
    display: inline-block;
    background: #8b7355;
    color: white;
    padding: 1.2rem 3.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1.1rem;
    text-decoration: none;
    transition:
      transform 0.3s,
      background 0.3s,
      box-shadow 0.3s;
    border: none;
    cursor: pointer;
  }

  .whatsapp-button:hover {
    transform: translateY(-2px);
    background: #9d8265;
    box-shadow: 0 10px 25px rgba(139, 115, 85, 0.3);
  }

  @media (max-width: 768px) {
    .contact {
      padding: 6rem 0;
    }

    .container {
      gap: 2rem;
    }

    .contact-title {
      font-size: clamp(2rem, 8vw, 3rem);
    }

    .whatsapp-button {
      padding: 1rem 2.5rem;
      font-size: 1rem;
    }
  }
</style>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: "0px 0px -100px 0px",
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
      }
    });
  }, observerOptions);

  document.querySelectorAll("[data-scroll-fade]").forEach((el) => {
    observer.observe(el);
  });
</script>
